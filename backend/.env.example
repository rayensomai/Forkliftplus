DATABASE_URL=sqlite:///./forkliftplus.db
APP_ENV=development
DEV_MAIL_ENABLED=true
DEV_MAIL_PORT=1025

# Local testing with MailHog (docker compose up -d mailhog)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=false
SMTP_FROM_EMAIL=no-reply@forkliftplus.com

# Real Gmail sending (requires Google App Password, not your normal password)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=your@gmail.com
# SMTP_PASSWORD=your-16-char-app-password
# SMTP_USE_TLS=true
# SMTP_FROM_EMAIL=your@gmail.com
